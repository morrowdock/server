  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Account": {
        "type": "object",
        "required": [
          "accountID"
        ],
        "properties": {
          "accountID": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Credits": {
        "type": "object",
        "required": [
          "credits"
        ],
        "properties": {
          "credits": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      },
      "Catalog": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "version",
            "checksum"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "checksum": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      },
      "Capabilities": {
        "type": "object",
        "required": [
          "apiVersion",
          "serverID",
          "features",
          "models",
          "billingMode"
        ],
        "properties": {
          "apiVersion": {
            "const": "1"
          },
          "serverID": {
            "type": "string"
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "models": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "billingMode": {
            "enum": [
              "hosted_credits",
              "operator_managed"
            ]
          }
        }
      },
      "RunRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operationID",
          "kind",
          "serverID",
          "accountID",
          "profileID",
          "sourceRevision",
          "sourceHash",
          "payloadDigest",
          "consentReceipt",
          "payload"
        ],
        "properties": {
          "operationID": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "enum": [
              "ai",
              "course_generation",
              "grading",
              "code_execution"
            ]
          },
          "serverID": {
            "type": "string",
            "minLength": 1
          },
          "accountID": {
            "type": "string",
            "minLength": 1
          },
          "profileID": {
            "type": "string",
            "minLength": 1
          },
          "consentReceipt": {
            "type": "string",
            "minLength": 1
          },
          "sourceRevision": {
            "type": "integer",
            "minimum": 1
          },
          "sourceHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "payloadDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "payload": {
            "type": "object"
          }
        }
      },
      "RunReceipt": {
        "type": "object",
        "required": [
          "operationID",
          "state",
          "payloadDigest"
        ],
        "properties": {
          "operationID": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "enum": [
              "pending",
              "running",
              "succeeded",
              "failed",
              "cancelled"
            ]
          },
          "payloadDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "result": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      },
      "Snapshot": {
        "type": "object",
        "required": [
          "profileID",
          "revision",
          "contentDigest",
          "payload"
        ],
        "properties": {
          "profileID": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "contentDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "payload": {
            "type": "object"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "operationID": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
